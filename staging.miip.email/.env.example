# ══════════════════════════════════════════════
#  IPScope - Configuración de API Keys
#  Copiá este archivo como .env y completá los valores
#  NUNCA subas .env a Git o repositorios públicos
# ══════════════════════════════════════════════

# ── ipdata.co ──────────────────────────────────
# Registro gratuito en: https://ipdata.co
IPDATA_API_KEY=

# ── AbuseIPDB ──────────────────────────────────
# Registro gratuito en: https://www.abuseipdb.com/register
# (1000 requests/día en plan free)
# En FacuTools: Configuración → Integraciones → abuseipdb_key
ABUSEIPDB_KEY=

# ── SpamRATS ───────────────────────────────────
# Registro en: https://www.spamrats.com
# Sin key, las listas SpamRATS se omiten automáticamente
# En FacuTools: Configuración → Integraciones → spamrats_key
SPAMRATS_KEY=

# ── Spamhaus DQS ───────────────────────────────
# Data Query Service (gratis): https://www.spamhaus.com/free-trial/data-query-service/
# Permite consultar ZEN/SBL/XBL/PBL sin bloqueo de resolvers públicos
# En FacuTools: Configuración → Integraciones → spamhaus_dqs_key
SPAMHAUS_DQS_KEY=

# ── Diagnóstico (podés borrar esto en producción) ─────────────
# Token para acceder a /api/test_spamrats.php — poné cualquier texto
TEST_TOKEN=

# ── Ransomware Live ────────────────────────────
# Token PRO de Ransomware Live (opcional, si se omite usa la API gratuita con límite)
RANSOMWARE_LIVE_KEY=

# ── MACVendors ─────────────────────────────────
# Token / API Key de MACVendors.com (opcional para plan pago, si se omite usa la API pública gratuita)
MACVENDORS_API_KEY=

