# Local Docker Compose — optional overrides
POSTGRES_USER=facutools
POSTGRES_PASSWORD=facutools
POSTGRES_DB=facutools
POSTGRES_PORT=5432

# Required by the FastAPI app
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_VALID_FERNET_KEY

# Optional: enables automated Microsoft Entra tenant onboarding.
# Register the bootstrap app as multitenant and grant it delegated
# Microsoft Graph Application.ReadWrite.All, as documented in docs/sso-entra-id.md.
ENTRA_ONBOARDING_CLIENT_ID=
ENTRA_ONBOARDING_CLIENT_SECRET=
