# Plantilla completa de vhost (solo si CloudPanel no permite "additional directives").
# Sustituí DOMAIN, WEB_ROOT y rutas SSL por las que genera CloudPanel.
#
# En la práctica conviene dejar que CloudPanel gestione el server {} y SSL,
# y solo pegar nginx-location.conf en Additional directives.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name DOMAIN;

    # CloudPanel suele inyectar estas rutas de certificados:
    # ssl_certificate     /etc/nginx/ssl-certificates/DOMAIN.crt;
    # ssl_certificate_key /etc/nginx/ssl-certificates/DOMAIN.key;

    root WEB_ROOT;
    index index.html;

    client_max_body_size 50m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
