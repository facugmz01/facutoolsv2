# Ruta al clon del repositorio en el NAS (directorios backend/ y frontend/)
FACUTOOLS_REPO=/mnt/pool/apps/facutools/repo

# Dataset persistente: certificados ACME en la raíz; Postgres en ./postgres
FACUTOOLS_DATA=/mnt/pool/apps/facutools/data

# Puerto HTTP expuesto en el host (usar >1024 si TrueNAS no permite privilegiados)
FACUTOOLS_HTTP_PORT=8080

# PostgreSQL (cambiar POSTGRES_PASSWORD en producción)
POSTGRES_USER=facutools
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=facutools
