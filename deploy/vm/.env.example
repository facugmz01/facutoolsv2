# ── FacuTools VM ──────────────────────────────────────────────
# Copiá a .env y editá antes de instalar:
#   cp .env.example .env

# Puerto HTTP publicado en la VM (80 requiere root/capabilities; 8080 es más simple)
FACUTOOLS_HTTP_PORT=80

# Directorio de datos en el host (Postgres + certificados ACME)
# Ruta absoluta recomendada en producción, ej: /opt/facutools/data
FACUTOOLS_DATA=./data

# PostgreSQL — CAMBIAR la contraseña en producción
POSTGRES_USER=facutools
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
POSTGRES_DB=facutools

# Required application secrets. Generate with:
#   openssl rand -hex 32
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# URL pública (para SSO callbacks y links). Se puede setear también en Settings → General.
# FACUTOOLS_PUBLIC_URL=https://facutools.ejemplo.com
